# Google OAuth2設定
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback

# JWT設定
JWT_SECRET=your-secret-key-change-in-production
JWT_ISSUER=p-log
JWT_AUDIENCE=p-log-users

# Database設定
# ローカル開発用（標準PostgreSQL接続）
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=p-log
DB_SSLMODE=disable

# Cloud SQL設定（本番環境用）
# Cloud SQLを使用する場合はUSE_CLOUD_SQL=trueに設定
USE_CLOUD_SQL=false
# Cloud SQLインスタンス接続名（例: project-id:region:instance-name）
CLOUD_SQL_INSTANCE=your-project:your-region:your-instance
# IAM認証を使用する場合はtrueに設定（Cloud Run上では推奨）
USE_IAM_AUTH=true
# IAM認証を使用しない場合はDB_PASSWORDを設定

# Google Cloud認証設定
# ローカル開発でサービスアカウントキーを使用する場合
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Google Cloud Storage設定
# 画像アップロード先のGCSバケット名
GCS_BUCKET_NAME=your-bucket-name
